{
  "name": "rate-wave",
  "short_name": "rate-wave",
  "description": "Listen and rate recordings on a five-star scale; ratings stored in MP3 tags (POPM).",
  "start_url": "/rate-wave/",
  "scope": "/rate-wave/",
  "display": "standalone",
  "background_color": "#0f1115",
